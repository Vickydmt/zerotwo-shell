#!/usr/bin/env python3
"""
ZeroTwo USB Tool - Modern GTK4 / Libadwaita GUI
Flash Bootable ISOs & Restore Normal Pendrives (FAT32/exFAT/NTFS)
Works on Hyprland and ANY Linux distribution.
"""

import sys
import os
import json
import subprocess
import threading
import time

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Gtk, Adw, GLib, Gio

BACKEND_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "zerotwo-usb")
if not os.path.exists(BACKEND_PATH):
    BACKEND_PATH = "/usr/local/bin/zerotwo-usb"

class UsbToolWindow(Adw.ApplicationWindow):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)

        self.set_title("ZeroTwo USB Tool")
        self.set_default_size(580, 680)

        self.devices = []
        self.selected_iso_path = ""
        self.is_operating = False

        # Main Box
        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.set_content(main_box)

        # Header Bar
        header = Adw.HeaderBar()
        title_widget = Adw.WindowTitle(title="ZeroTwo USB Tool", subtitle="Bootable ISO Flasher & Storage Formatter")
        header.set_title_widget(title_widget)

        # Refresh button
        self.btn_refresh = Gtk.Button(icon_name="view-refresh-symbolic")
        self.btn_refresh.set_tooltip_text("Refresh connected USB drives")
        self.btn_refresh.connect("clicked", lambda _: self.refresh_drives())
        header.pack_start(self.btn_refresh)

        main_box.append(header)

        # View Switcher Bar
        self.view_stack = Adw.ViewStack()
        
        switcher = Adw.ViewSwitcher(
            stack=self.view_stack,
            policy=Adw.ViewSwitcherPolicy.WIDE
        )
        switcher_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        switcher_box.set_halign(Gtk.Align.CENTER)
        switcher_box.set_margin_top(12)
        switcher_box.set_margin_bottom(8)
        switcher_box.append(switcher)
        main_box.append(switcher_box)

        # Build Tabs
        self.build_flash_tab()
        self.build_format_tab()

        main_box.append(self.view_stack)

        # Operation Progress Box at bottom
        self.progress_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.progress_box.set_margin_start(24)
        self.progress_box.set_margin_end(24)
        self.progress_box.set_margin_bottom(20)
        self.progress_box.set_visible(False)

        self.lbl_progress = Gtk.Label(label="Ready")
        self.lbl_progress.set_halign(Gtk.Align.START)
        self.lbl_progress.add_css_class("heading")

        self.progress_bar = Gtk.ProgressBar()
        self.progress_bar.set_show_text(True)
        self.progress_bar.set_fraction(0.0)

        self.progress_box.append(self.lbl_progress)
        self.progress_box.append(self.progress_bar)
        main_box.append(self.progress_box)

        # Initial drive scan
        GLib.idle_add(self.refresh_drives)

    def build_flash_tab(self):
        page_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        page_box.set_margin_start(24)
        page_box.set_margin_end(24)
        page_box.set_margin_top(12)
        page_box.set_margin_bottom(16)

        # Preferences Group for ISO file
        group_iso = Adw.PreferencesGroup(title="1. Select ISO Image")
        page_box.append(group_iso)

        self.row_iso = Adw.ActionRow(title="No ISO file selected", subtitle="Click Browse to select .iso or .img file")
        self.row_iso.add_prefix(Gtk.Image.new_from_icon_name("media-optical-symbolic"))

        btn_browse = Gtk.Button(label="Browse…")
        btn_browse.add_css_class("suggested-action")
        btn_browse.set_valign(Gtk.Align.CENTER)
        btn_browse.connect("clicked", self.on_browse_iso)
        self.row_iso.add_suffix(btn_browse)
        group_iso.add(self.row_iso)

        # Preferences Group for Target Drive
        group_drive = Adw.PreferencesGroup(title="2. Select Destination USB Drive")
        page_box.append(group_drive)

        self.flash_drive_model = Gtk.StringList()
        self.combo_flash_drive = Adw.ComboRow(title="Target USB Drive", model=self.flash_drive_model)
        self.combo_flash_drive.add_prefix(Gtk.Image.new_from_icon_name("drive-removable-media-symbolic"))
        group_drive.add(self.combo_flash_drive)

        # Safety Notice
        notice_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        notice_box.set_margin_top(4)
        notice_icon = Gtk.Image.new_from_icon_name("dialog-warning-symbolic")
        notice_icon.set_icon_size(Gtk.IconSize.NORMAL)
        lbl_notice = Gtk.Label(label="Flashing will erase ALL data on the selected USB drive. System drives are hidden for your safety.")
        lbl_notice.set_wrap(True)
        lbl_notice.add_css_class("caption")
        lbl_notice.add_css_class("dim-label")
        notice_box.append(notice_icon)
        notice_box.append(lbl_notice)
        page_box.append(notice_box)

        # Flash Action Button
        self.btn_flash = Gtk.Button(label="Flash Bootable USB")
        self.btn_flash.add_css_class("destructive-action")
        self.btn_flash.add_css_class("pill")
        self.btn_flash.set_size_request(-1, 48)
        self.btn_flash.set_margin_top(16)
        self.btn_flash.connect("clicked", self.on_start_flash)
        page_box.append(self.btn_flash)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_child(page_box)
        scrolled.set_propagate_natural_height(True)

        self.view_stack.add_titled(scrolled, "flash", "Flash ISO").set_icon_name("media-optical-symbolic")

    def build_format_tab(self):
        page_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        page_box.set_margin_start(24)
        page_box.set_margin_end(24)
        page_box.set_margin_top(12)
        page_box.set_margin_bottom(16)

        # Target USB Drive
        group_drive = Adw.PreferencesGroup(title="1. Select USB Drive to Restore")
        page_box.append(group_drive)

        self.format_drive_model = Gtk.StringList()
        self.combo_format_drive = Adw.ComboRow(title="Target USB Drive", model=self.format_drive_model)
        self.combo_format_drive.add_prefix(Gtk.Image.new_from_icon_name("drive-removable-media-symbolic"))
        group_drive.add(self.combo_format_drive)

        # Options Group
        group_opts = Adw.PreferencesGroup(title="2. Filesystem &amp; Label")
        page_box.append(group_opts)

        # Filesystem type
        self.fs_types = [
            ("fat32", "FAT32 (Maximum Compatibility: Mobile, Smart TV, PC, Mac)"),
            ("exfat", "exFAT (Large Movies >4GB: Modern 4K TVs, PC, Mac)"),
            ("ntfs", "NTFS (Windows PC Compatible)"),
            ("ext4", "ext4 (Linux Native)")
        ]
        self.fs_model = Gtk.StringList.new([name for _, name in self.fs_types])
        self.combo_fs = Adw.ComboRow(title="Filesystem Format", model=self.fs_model)
        self.combo_fs.set_selected(0)  # Default FAT32
        group_opts.add(self.combo_fs)

        # Label Entry
        self.entry_label = Adw.EntryRow(title="Volume Label")
        self.entry_label.set_text("MOVIES")
        group_opts.add(self.entry_label)

        # Info Box
        info_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        info_box.set_margin_top(4)
        info_icon = Gtk.Image.new_from_icon_name("emblem-default-symbolic")
        info_icon.set_icon_size(Gtk.IconSize.NORMAL)
        lbl_info = Gtk.Label(label="Removes ISO/bootable remnants and restores full storage capacity with Android/TV compatible boot sectors.")
        lbl_info.set_wrap(True)
        lbl_info.add_css_class("caption")
        lbl_info.add_css_class("dim-label")
        info_box.append(info_icon)
        info_box.append(lbl_info)
        page_box.append(info_box)

        # Format Button
        self.btn_format = Gtk.Button(label="Restore & Format Pendrive")
        self.btn_format.add_css_class("suggested-action")
        self.btn_format.add_css_class("pill")
        self.btn_format.set_size_request(-1, 48)
        self.btn_format.set_margin_top(16)
        self.btn_format.connect("clicked", self.on_start_format)
        page_box.append(self.btn_format)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_child(page_box)
        scrolled.set_propagate_natural_height(True)

        self.view_stack.add_titled(scrolled, "format", "Restore Pendrive").set_icon_name("drive-harddisk-symbolic")

    def refresh_drives(self):
        """Query connected USB drives via backend."""
        try:
            proc = subprocess.run([BACKEND_PATH, "list", "--json"], capture_output=True, text=True, check=True)
            self.devices = json.loads(proc.stdout)
        except Exception as e:
            self.devices = []

        # Update Combo Models
        drive_names = []
        for d in self.devices:
            drive_names.append(f"{d['model']} ({d['path']}) — {d['human_size']}")

        if not drive_names:
            drive_names = ["No USB Drives Detected"]

        # Rebuild string lists
        self.flash_drive_model.splice(0, self.flash_drive_model.get_n_items(), drive_names)
        self.format_drive_model.splice(0, self.format_drive_model.get_n_items(), drive_names)

        has_drives = len(self.devices) > 0
        self.combo_flash_drive.set_sensitive(has_drives)
        self.combo_format_drive.set_sensitive(has_drives)
        self.btn_flash.set_sensitive(has_drives and bool(self.selected_iso_path) and not self.is_operating)
        self.btn_format.set_sensitive(has_drives and not self.is_operating)

    def on_browse_iso(self, widget):
        dialog = Gtk.FileDialog(title="Select Bootable ISO or Disk Image")
        filter_iso = Gtk.FileFilter()
        filter_iso.set_name("Disk Images (*.iso, *.img)")
        filter_iso.add_pattern("*.iso")
        filter_iso.add_pattern("*.img")

        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filter_iso)
        dialog.set_filters(filters)

        dialog.open(self, None, self.on_iso_chosen)

    def on_iso_chosen(self, dialog, result):
        try:
            file = dialog.open_finish(result)
            if file:
                path = file.get_path()
                self.selected_iso_path = path
                size_mb = os.path.getsize(path) / (1024 * 1024)
                if size_mb >= 1024:
                    size_str = f"{size_mb / 1024:.2f} GB"
                else:
                    size_str = f"{size_mb:.1f} MB"

                self.row_iso.set_title(os.path.basename(path))
                self.row_iso.set_subtitle(f"{size_str} — {path}")
                self.btn_flash.set_sensitive(len(self.devices) > 0 and not self.is_operating)
        except Exception:
            pass

    def on_start_flash(self, widget):
        idx = self.combo_flash_drive.get_selected()
        if idx >= len(self.devices):
            return

        target_dev = self.devices[idx]
        iso_name = os.path.basename(self.selected_iso_path)

        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Flash Bootable USB?",
            body=f"Are you sure you want to flash '{iso_name}' to {target_dev['model']} ({target_dev['path']})?\n\nWARNING: All existing files on {target_dev['path']} will be completely erased!"
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("flash", "Erase & Flash")
        dialog.set_response_appearance("flash", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.connect("response", self.on_flash_confirmed, target_dev["path"])
        dialog.present()

    def on_flash_confirmed(self, dialog, response, dev_path):
        if response != "flash":
            return
        self.run_privileged_task([BACKEND_PATH, "flash", self.selected_iso_path, dev_path, "--json"], "Flashing Bootable ISO")

    def on_start_format(self, widget):
        idx = self.combo_format_drive.get_selected()
        if idx >= len(self.devices):
            return

        target_dev = self.devices[idx]
        fs_key = self.fs_types[self.combo_fs.get_selected()][0]
        label = self.entry_label.get_text().strip() or "MOVIES"

        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Restore & Format Pendrive?",
            body=f"Are you sure you want to format {target_dev['model']} ({target_dev['path']}) as {fs_key.upper()} with label '{label}'?\n\nThis will remove any ISO/bootable remnants and restore full normal storage capacity."
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("format", "Format Pendrive")
        dialog.set_response_appearance("format", Adw.ResponseAppearance.SUGGESTED)
        dialog.connect("response", self.on_format_confirmed, target_dev["path"], fs_key, label)
        dialog.present()

    def on_format_confirmed(self, dialog, response, dev_path, fs_key, label):
        if response != "format":
            return
        self.run_privileged_task([BACKEND_PATH, "format", dev_path, "--fs", fs_key, "--label", label, "--json"], f"Formatting Pendrive ({fs_key.upper()})")

    def run_privileged_task(self, cmd_args, task_title):
        self.is_operating = True
        self.progress_box.set_visible(True)
        self.progress_bar.set_fraction(0.0)
        self.lbl_progress.set_text(f"Starting {task_title}...")
        self.btn_flash.set_sensitive(False)
        self.btn_format.set_sensitive(False)
        self.btn_refresh.set_sensitive(False)
        self.combo_flash_drive.set_sensitive(False)
        self.combo_format_drive.set_sensitive(False)

        def worker():
            full_cmd = ["pkexec"] + cmd_args
            try:
                proc = subprocess.Popen(full_cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, bufsize=1)
                
                for line in iter(proc.stdout.readline, ''):
                    if not line:
                        break
                    line = line.strip()
                    try:
                        data = json.loads(line)
                        pct = data.get("progress", 0) / 100.0
                        msg = data.get("message", "")
                        GLib.idle_add(self.update_progress, pct, msg)
                    except Exception:
                        pass

                proc.wait()
                rc = proc.returncode
                err = proc.stderr.read()
                GLib.idle_add(self.task_finished, rc, err, task_title)
            except Exception as e:
                GLib.idle_add(self.task_finished, 1, str(e), task_title)

        threading.Thread(target=worker, daemon=True).start()

    def update_progress(self, pct, msg):
        self.progress_bar.set_fraction(pct)
        self.lbl_progress.set_text(msg)
        return False

    def task_finished(self, rc, err, task_title):
        self.is_operating = False
        self.btn_refresh.set_sensitive(True)
        self.refresh_drives()

        if rc == 0:
            self.lbl_progress.set_text(f"✓ {task_title} completed successfully!")
            self.progress_bar.set_fraction(1.0)
            dialog = Adw.MessageDialog(
                transient_for=self,
                heading="Operation Successful",
                body=f"{task_title} has finished successfully! Your USB drive is ready."
            )
            dialog.add_response("ok", "OK")
            dialog.present()
        else:
            self.lbl_progress.set_text(f"✗ {task_title} failed.")
            dialog = Adw.MessageDialog(
                transient_for=self,
                heading="Operation Failed",
                body=f"An error occurred while executing {task_title}:\n\n{err or 'Authentication cancelled or write error.'}"
            )
            dialog.add_response("ok", "Close")
            dialog.set_response_appearance("ok", Adw.ResponseAppearance.DESTRUCTIVE)
            dialog.present()

        return False

class UsbToolApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.zerotwo.usbtool", flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        win = self.props.active_window
        if not win:
            win = UsbToolWindow(application=self)
        win.present()

def main():
    app = UsbToolApp()
    return app.run(sys.argv)

if __name__ == "__main__":
    sys.exit(main())
