{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "position": "auto",
        "source": "/home/zerotwo/.config/fastfetch/zt.txt",
        "padding": {
            "right": 2
        }
    },
    "display": {
        "separator": " : "
    },
    "modules": [
        "break",
        {
            "type": "title",
            "format": "  {#33}{user-name}{#37}@{#33}{host-name}{#}"
        },
        {
            "type": "custom",
            "format": "{#37}┌──────────────────────────────────────────────┐{#}"
        },
        {
            "type": "os",
            "key": "  󰣇 OS",
            "keyColor": "red",
            "format": "{pretty-name}"
        },
        {
            "type": "cpu",
            "key": "  󰍛 CPU",
            "keyColor": "cyan",
            "format": "{name} @ {freq-max}"
        },
        {
            "type": "gpu",
            "key": "  󰢮 dGPU",
            "keyColor": "blue",
            "hideType": "integrated",
            "format": "{name} (8GB)"
        },
        {
            "type": "memory",
            "key": "  󰘚 Memory",
            "keyColor": "magenta",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "kernel",
            "key": "  󰒋 Kernel",
            "keyColor": "yellow",
            "format": "{release}"
        },
        {
            "type": "packages",
            "key": "  󰏖 Packages",
            "keyColor": "red",
            "format": "{all} (pacman)"
        },
        {
            "type": "command",
            "key": "  󰔠 OS Age",
            "keyColor": "magenta",
            "text": "days=$(( ($(date +%s) - $(head -n1 /var/log/pacman.log 2>/dev/null | cut -d'[' -f2 | cut -d']' -f1 | xargs -I{} date -d {} +%s 2>/dev/null || date +%s)) / 86400 )); if [ \"$days\" -le 0 ]; then echo \"0 days\"; elif [ \"$days\" -eq 1 ]; then echo \"1 day\"; else echo \"$days days\"; fi"
        },
        {
            "type": "uptime",
            "key": "  󰥔 Uptime",
            "keyColor": "red",
            "format": "{?days}{days} days, {?}{hours} hours, {minutes} mins"
        },
        {
            "type": "terminal",
            "key": "  >_ Terminal",
            "keyColor": "white",
            "format": "{pretty-name} {version}"
        },
        {
            "type": "wm",
            "key": "  󰨇 WM",
            "keyColor": "white",
            "format": "{pretty-name}"
        },
        {
            "type": "custom",
            "format": "{#37}└──────────────────────────────────────────────┘{#}"
        },
        "break"
    ]
}
